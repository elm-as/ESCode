{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dashboard": "tsc && vite build -c vite.dashboard.config.ts",
    "build:extension": "tsc -p tsconfig.extension.json",
    "setup:standalone": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-standalone-studio.ps1",
    "start:studio": "powershell -Command \"& './Elmas-Studio-Desktop/Elmas Studio.exe' .\"",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.13",
    "@astryxdesign/theme-neutral": "0.7.13",
    "@monaco-editor/react": "^4.7.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.106.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "dockview": "^8.8.3",
    "dockview-react": "^8.8.3",
    "lucide-react": "^1.69.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/vscode": "^1.145.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
