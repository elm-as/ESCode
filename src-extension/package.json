{
  "name": "elmas-studio-core",
  "displayName": "Elmas Studio — Moteur Mobile",
  "description": "Aperçu mobile en temps réel multi-frameworks pour HTML/CSS/JS, React Web, React Native, Flutter et Kotlin Compose",
  "version": "1.0.0",
  "publisher": "elmascore",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "elmas-studio-container",
          "title": "Elmas Studio",
          "icon": "media/device-icon.svg"
        }
      ]
    },
    "views": {
      "elmas-studio-container": [
        {
          "type": "webview",
          "id": "elmasStudio.missionControlView",
          "name": "Mission Control (Cockpit)"
        },
        {
          "type": "webview",
          "id": "elmasStudio.devicePreview",
          "name": "Appareil Mobile Virtuel"
        }
      ]
    },
    "commands": [
      {
        "command": "elmasStudio.openMissionControl",
        "title": "Ouvrir Mission Control (Tableau de Bord)",
        "category": "Elmas Studio",
        "icon": "$(dashboard)"
      },
      {
        "command": "elmasStudio.openPreview",
        "title": "Ouvrir l'Aperçu Mobile",
        "category": "Elmas Studio",
        "icon": "$(device-mobile)"
      },
      {
        "command": "elmasStudio.runProject",
        "title": "Lancer l'Aperçu Mobile",
        "category": "Elmas Studio",
        "icon": "$(play)"
      },
      {
        "command": "elmasStudio.stopProject",
        "title": "Arrêter le Serveur d'Aperçu",
        "category": "Elmas Studio",
        "icon": "$(primitive-square)"
      },
      {
        "command": "elmasStudio.openSdkManager",
        "title": "Gestionnaire SDK & Outils",
        "category": "Elmas Studio"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "elmasStudio.openMissionControl",
          "group": "navigation"
        },
        {
          "command": "elmasStudio.openPreview",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "elmasStudio.openMissionControl",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      }
    ],
    "configuration": {
      "title": "Elmas Studio",
      "properties": {
        "elmasStudio.sdkPaths.androidSdk": {
          "type": "string",
          "default": "",
          "description": "Chemin personnalisé vers le dossier Android SDK"
        },
        "elmasStudio.sdkPaths.flutterSdk": {
          "type": "string",
          "default": "",
          "description": "Chemin personnalisé vers le dossier Flutter SDK"
        }
      }
    }
  }
}
