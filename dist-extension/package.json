{
  "name": "elmas-studio-core",
  "displayName": "Elmas Studio — Moteur Mobile",
  "description": "Aperçu mobile en temps réel multi-frameworks pour HTML/CSS/JS, React Web, React Native, Flutter et Kotlin Compose",
  "version": "1.0.0",
  "publisher": "elmascore",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onWebviewPanel:elmasStudio.devicePreviewPanel",
    "onView:elmasStudio.terminalChat"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "elmas-terminal-chat-panel",
          "title": "Terminal Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "elmas-terminal-chat-panel": [
        {
          "type": "webview",
          "id": "elmasStudio.terminalChat",
          "name": "Terminal Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "elmasStudio.openPreview",
        "title": "Ouvrir l'Aperçu Mobile",
        "category": "Elmas Studio",
        "icon": "$(device-mobile)"
      },
      {
        "command": "elmasStudio.runProject",
        "title": "Lancer l'Aperçu Mobile",
        "category": "Elmas Studio",
        "icon": "$(play)"
      },
      {
        "command": "elmasStudio.stopProject",
        "title": "Arrêter le Serveur d'Aperçu",
        "category": "Elmas Studio",
        "icon": "$(primitive-square)"
      },
      {
        "command": "elmasStudio.openSdkManager",
        "title": "Gestionnaire SDK & Outils",
        "category": "Elmas Studio"
      },
      {
        "command": "elmasStudio.ghostConfig",
        "title": "Inspecteur AST & Flux Syntaxique",
        "category": "Elmas Studio"
      },
      {
        "command": "elmasStudio.ghostToggle",
        "title": "Basculer l'Analyse AST en Direct",
        "category": "Elmas Studio"
      },
      {
        "command": "elmasStudio.ghostManual",
        "title": "Activer le Tampon Clavier AST",
        "category": "Elmas Studio"
      },
      {
        "command": "elmasStudio.ghostAuto",
        "title": "Activer le Flux AST Continu",
        "category": "Elmas Studio"
      },
      {
        "command": "elmasStudio.ghostStop",
        "title": "Arrêter le Flux AST",
        "category": "Elmas Studio"
      }
    ],
    "keybindings": [
      {
        "command": "elmasStudio.ghostToggle",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "elmasStudio.ghostConfig",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "elmasStudio.openPreview",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Elmas Studio",
      "properties": {
        "elmasStudio.sdkPaths.androidSdk": {
          "type": "string",
          "default": "",
          "description": "Chemin personnalisé vers le dossier Android SDK"
        },
        "elmasStudio.sdkPaths.flutterSdk": {
          "type": "string",
          "default": "",
          "description": "Chemin personnalisé vers le dossier Flutter SDK"
        }
      }
    }
  }
}
